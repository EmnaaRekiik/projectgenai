# Local-development values only. Generate fresh strong secrets; NEVER commit your .env file.
POSTGRES_USER=smartcampus
POSTGRES_DB=smartcampus
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_HOST_PORT=55432
ADMIN_API_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_KEY_AT_LEAST_32_CHARACTERS
# For authenticated staff access after bootstrapping the first admin:
STAFF_SESSION_TTL_HOURS=12
# Only used when executing Python directly on Windows (not in Docker):
# DATABASE_URL=postgresql+psycopg://smartcampus:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@127.0.0.1:55432/smartcampus

# Optional live model. No LLM request is made until these are configured.
# For Ollama running on your Windows host (requires a downloaded local model):
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:3b-instruct
# LLM_API_KEY=
# For a hosted OpenAI-compatible provider use its HTTPS /v1 base URL and API key.
# Never commit API keys; model requests may be sent to the configured provider.

# Automatic retention: the Docker 'retention' service purges old sessions hourly.
RETENTION_INTERVAL_SECONDS=3600
VISITOR_SESSION_TTL_HOURS=24
VISITOR_MAX_MESSAGES=200
VISITOR_CREATIONS_PER_HOUR=300
CANDIDATE_SESSION_TTL_HOURS=12
CANDIDATE_REGISTRATIONS_PER_HOUR=10
CANDIDATE_LOGIN_ATTEMPTS_PER_HOUR=60

# To enable real candidate email verification, set all SMTP variables securely.
# Accounts can register and login without SMTP, but email_verified_at remains NULL.
# TLS STARTTLS is enforced by app/auth/verification.py.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
